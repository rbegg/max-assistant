{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard_flat": {
            "format": "[%(levelname)s] %(asctime)s - %(name)s (%(filename)s:%(lineno)d): %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "standard_flat",
            "stream": "ext://sys.stdout"
        },
        "rotating_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "standard_flat",
            "filename": "logs/assistant.log",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8",
            "delay": true
        },
        "rotating_error_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "standard_flat",
            "filename": "logs/error.log",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8",
            "level": "ERROR",
            "delay": true
        }
    },
    "loggers": {
        "": {
            "handlers": ["console", "rotating_file", "rotating_error_file"],
            "level": "INFO"
        },
        "uvicorn": {
            "level": "INFO",
            "propagate": false,
            "handlers": ["console", "rotating_file", "rotating_error_file"]
        },
        "max_assistant": {
            "level": "INFO",
            "propagate": true
        },
        "max_assistant.tools":{
            "level": "DEBUG",
            "propagate": true
        }
    }
}